{
  "rules": {
    ".read": false,
    ".write": false,

    "resellers": {
      ".read": "auth != null",
      "$hash": {
        ".write": "auth != null && auth.token.email === 'bytemisan@gmail.com'"
      }
    },

    "applications": {
      ".read": "auth != null && auth.token.email === 'bytemisan@gmail.com'",
      ".write": "auth != null && auth.token.email === 'bytemisan@gmail.com'",
      "$secret": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "webhookSettings": {
      ".read": "auth != null && auth.token.email === 'bytemisan@gmail.com'",
      ".write": "auth != null && auth.token.email === 'bytemisan@gmail.com'",
      "$secret": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "customers": {
      ".read": "auth != null && auth.token.email === 'bytemisan@gmail.com'",
      "$emailKey": {
        ".read": "auth != null && (data.child('email').val() === auth.token.email || auth.token.email === 'bytemisan@gmail.com')",
        ".write": "auth != null && (data.child('email').val() === auth.token.email || newData.child('email').val() === auth.token.email || auth.token.email === 'bytemisan@gmail.com')"
      }
    },

    "system": {
      "stats": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'bytemisan@gmail.com'"
      },
      "plans": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'bytemisan@gmail.com'"
      },
      "config": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'bytemisan@gmail.com'"
      }
    }
  }
}
